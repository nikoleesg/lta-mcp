{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lta-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  }
  // No KV namespace: DataMall authenticates with a static AccountKey header,
  // so there is no token to fetch or cache (unlike onemap-mcp).
  //
  // Secret (never set here — see README "Setup"), required:
  //   LTA_ACCOUNT_KEY
}
